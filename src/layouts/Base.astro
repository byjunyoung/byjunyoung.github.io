---
// src/layouts/Base.astro
import '../styles/global.css';
import { localePath, type Lang } from '../lib/i18n';
interface Props { title?: string; description?: string; ogImage?: string; lang?: Lang; altPath?: string }
const {
  title,
  description = 'Hardware UX designer. I design the part of products that lives beyond the screen — form, touch, space, feedback.',
  ogImage,
  lang = 'ko',
  altPath,
} = Astro.props;
const fullTitle = title ? `${title} — Junyoung Kim` : 'Junyoung Kim';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 언어 자동 전환 — 배지로 고른 언어(site-lang, 이력서와 공유)가 있으면 그걸, 없으면 브라우저 언어로 정해 짝 페이지로 보낸다. 그리기 전에 돌아야 해서 헤드 맨 앞 */}
    <script is:inline define:vars={{ pageLang: lang, altPath: altPath ?? null }}>
      (function () {
        if (!altPath) return; // 영어 짝이 없는 페이지는 그대로
        if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return; // 검색 색인은 hreflang이 담당
        var KEY = 'site-lang', want = null;
        try { want = localStorage.getItem(KEY); } catch (e) {}
        if (want !== 'ko' && want !== 'en') {
          var first = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          want = /^ko\b/i.test(first) ? 'ko' : 'en';
          try { localStorage.setItem(KEY, want); } catch (e) {}
        }
        if (want === pageLang) return;
        window.__langRedirect = true; // 분석 스니펫이 이동 전 페이지를 세지 않게 알린다
        location.replace(want === 'en' ? '/en' + altPath : altPath);
      })();
    </script>
    {/* GA4 — 페이지별 활성 시간·유입 경로. 언어 자동 이동 중이면 이동 전 페이지를 세지 않는다 */}
    <script is:inline>
      if (!window.__langRedirect) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-QNYBB3W6N9');
        var ga = document.createElement('script');
        ga.async = true; ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-QNYBB3W6N9';
        document.head.appendChild(ga);
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {altPath && <link rel="alternate" hreflang="ko" href={new URL(altPath, Astro.site)} />}
    {altPath && <link rel="alternate" hreflang="en" href={new URL('/en' + altPath, Astro.site)} />}
    {altPath && <link rel="alternate" hreflang="x-default" href={new URL(altPath, Astro.site)} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <header class="nav">
      <a class="mark" href={localePath(lang, '/about/')}>Junyoung Kim</a>
      <nav>
        <a href={localePath(lang, '/')}>work</a>
        <a href={localePath(lang, '/activity/')}>activity</a>
        <a href={localePath(lang, '/play/')}>play</a>
        <a href={localePath(lang, '/blog/')}>blog</a>
        <a href={`https://byjunyoung.github.io/resume/?lang=${lang}`}>resume</a>
      </nav>
      <div class="lang" aria-label="Language">
        <a href={altPath ?? '/'} class={lang === 'ko' ? 'active' : undefined} hreflang="ko" lang="ko">KR</a>
        <a href={altPath ? `/en${altPath}` : '/en/'} class={lang === 'en' ? 'active' : undefined} hreflang="en" lang="en">EN</a>
      </div>
    </header>
    <script is:inline>
      // KR/EN 배지를 누르면 그 선택을 기억해 자동 전환이 다시 끼어들지 않게 한다
      document.querySelectorAll('.lang a[lang]').forEach(function (a) {
        a.addEventListener('click', function () {
          try { localStorage.setItem('site-lang', a.getAttribute('lang')); } catch (e) {}
        });
      });
    </script>
    <main class="wrap"><slot /></main>
    <footer class="footer wrap">
      <div>
        <div class="n">Junyoung Kim</div>
        <a href="mailto:junyoung735@gmail.com">junyoung735@gmail.com</a>
      </div>
      <div class="footer-links">
        <a href="https://github.com/byjunyoung">GitHub</a>
        <a href="https://www.linkedin.com/in/byjunyoung/">LinkedIn</a>
        <a href="https://www.instagram.com/byjunyoung/">Instagram</a>
      </div>
    </footer>
  </body>
</html>
