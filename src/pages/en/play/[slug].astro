---
// src/pages/en/playground/[slug].astro
import PlaygroundDetail from '../../../components/pages/PlaygroundDetail.astro';
import { getCollection } from 'astro:content';
import { byLang, slugOf } from '../../../lib/i18n';

export async function getStaticPaths() {
  const items = byLang(await getCollection('playground'), 'en');
  return items.map((entry) => ({ params: { slug: slugOf(entry.id) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<PlaygroundDetail lang="en" entry={entry} />
