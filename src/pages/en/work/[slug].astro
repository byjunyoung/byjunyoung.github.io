---
// src/pages/en/works/[slug].astro
import WorkDetail from '../../../components/pages/WorkDetail.astro';
import { getCollection } from 'astro:content';
import { byLang, slugOf } from '../../../lib/i18n';

export async function getStaticPaths() {
  const works = byLang(await getCollection('works'), 'en');
  return works.map((entry, i) => ({ params: { slug: slugOf(entry.id) }, props: { entry, next: works[(i + 1) % works.length] } }));
}
const { entry, next } = Astro.props;
---
<WorkDetail lang="en" entry={entry} next={next} />
