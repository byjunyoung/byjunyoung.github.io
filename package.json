{
  "name": "byjunyoung.github.io",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "new:work": "node scripts/new-work.mjs",
    "media": "node scripts/media.mjs",
    "import:framer": "python3 scripts/import_framer.py",
    "test:import": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
